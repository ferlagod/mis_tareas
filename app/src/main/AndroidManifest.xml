<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recordatorios -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Avisos a la hora exacta. En Android 13+ USE_EXACT_ALARM se concede al instalar (Android 14+
      deniega por defecto SCHEDULE_EXACT_ALARM). Google Play solo lo admite en apps cuyo fin
      principal sea de alarmas o calendario: si se publica allí y lo rechazan, basta con quitarlo
      y la app seguirá pidiendo SCHEDULE_EXACT_ALARM desde Ajustes.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MisTareasApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisTareas">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MisTareas"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Añadir tareas con texto compartido desde otras apps (una por línea) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Acceso directo "Nueva tarea" (mantener pulsado el icono) -->
            <intent-filter>
                <action android:name="com.ferlagod.mistareas.action.NEW_TASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Avisos de tareas y botones "Hecha" / "Posponer" de la notificación -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Reprograma los avisos al reiniciar, al actualizar la app, al cambiar la hora o al conceder alarmas exactas -->
        <receiver
            android:name=".reminders.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
