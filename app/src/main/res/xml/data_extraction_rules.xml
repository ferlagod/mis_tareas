<!--
  Android 12+:
  - Copia en la nube de Google: solo las tareas y los ajustes visibles (no las credenciales,
    que dependen del Keystore de este dispositivo).
  - Transferencia directa entre dispositivos: igual.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="mistareas_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="mistareas_settings.xml" />
    </device-transfer>
</data-extraction-rules>
